{
  "name": "udodi-router",
  "version": "0.1.0",
  "description": "Optional, lightweight router for Udodi applications with client navigation and server-side metadata support for SEO",
  "keywords": [
    "udodi",
    "router",
    "spa",
    "routing",
    "navigation",
    "seo",
    "metadata"
  ],
  "homepage": "https://github.com/udodi-js/udodi-router#readme",
  "bugs": {
    "url": "https://github.com/udodi-js/udodi-router/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udodi-js/udodi-router.git"
  },
  "license": "MIT",
  "author": "Attamah Celestine .C",
  "type": "module",
  "sideEffects": false,

  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },

  "files": [
    "dist"
  ],

  "scripts": {
    "build": "tsup && node scripts/postbuild.js",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },

  "peerDependencies": {
    "udodi": "^1.1.4"
  },

  "devDependencies": {
    "@vitest/ui": "^5.0.5",
    "happy-dom": "^21.0.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "udodi": "^1.1.4",
    "vitest": "^5.0.5"
  }
}
